<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoltDeck" Width="1160" Height="785" MinWidth="840" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip"
        Background="Transparent" Foreground="{DynamicResource ThemeText}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Name="Track" Width="44" Height="25" CornerRadius="13" Background="{DynamicResource ThemeBase}"
                                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Margin="0,0,10,0">
                                <Ellipse Name="Thumb" Width="17" Height="17" Fill="#F4F1FA" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource ThemeBase}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#F4F1FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ThemeSwatch">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="11" Height="11" Fill="{Binding Swatch}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Label}"/>
            </StackPanel>
        </DataTemplate>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeControl}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A8F7F8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="Row" Padding="{TemplateBinding Padding}" Margin="0,3" Background="{DynamicResource ThemeControl}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeBorder}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeSelected}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="13"/>
        </Style>
        <Style x:Key="DashboardTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="MinHeight" Value="86"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel>
                            <Border Background="#F0F5FF" CornerRadius="7" Width="27" Height="27" HorizontalAlignment="Center">
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16"
                                      Stretch="Uniform" Stroke="#295FC3" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <TextBlock Text="{Binding}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashboardShortcut" TargetType="Button" BasedOn="{StaticResource DashboardTile}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Background="#F0F5FF" CornerRadius="8" Width="32" Height="32" Margin="0,0,9,0">
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Width="19" Height="19"
                                      Stretch="Uniform" Stroke="#295FC3" StrokeThickness="1.7"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Foreground="{DynamicResource ThemeMuted}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Border Name="WindowFrame" CornerRadius="19" Background="{DynamicResource ThemeBase}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
    <DockPanel>
        <Border Name="TitleBar" DockPanel.Dock="Top" Background="{DynamicResource ThemeSurface}" CornerRadius="18,18,0,0" Padding="17,6,8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Name="AboutButton" Content="Über VoltDeck" Padding="8,5" Margin="0,0,7,0"/>
                    <Button Name="DiscordButton" Width="39" Padding="0,5" Margin="0,0,7,0" Background="#332453" BorderBrush="#B990FF"
                            ToolTip="Discord" AutomationProperties.Name="Discord">
                        <Path Fill="#D5C0FF" Stretch="Uniform" Width="20" Height="16"
                              Data="M 20.3,4.4 A 19.8,19.8 0 0 0 15.4,2.9 L 14.8,4.2 A 18.5,18.5 0 0 0 9.2,4.2 L 8.6,2.9 A 19.8,19.8 0 0 0 3.7,4.4 C 0.6,9 0,13.4 0.3,17.8 A 20.2,20.2 0 0 0 6.3,20.8 L 7.6,18.6 L 5.5,17.6 L 6,17.2 C 9.8,18.9 14.2,18.9 18,17.2 L 18.5,17.6 L 16.4,18.6 L 17.7,20.8 A 20.2,20.2 0 0 0 23.7,17.8 C 24.2,12.8 22.8,8.5 20.3,4.4 Z M 8.1,15.2 C 7,15.2 6.1,14.2 6.1,12.9 C 6.1,11.6 7,10.6 8.1,10.6 C 9.2,10.6 10.1,11.6 10.1,12.9 C 10.1,14.2 9.2,15.2 8.1,15.2 Z M 15.9,15.2 C 14.8,15.2 13.9,14.2 13.9,12.9 C 13.9,11.6 14.8,10.6 15.9,10.6 C 17,10.6 17.9,11.6 17.9,12.9 C 17.9,14.2 17,15.2 15.9,15.2 Z"/>
                    </Button>
                    <Button Name="MinimizeButton" Content="—" Width="37" Padding="0,5" Margin="0,0,4,0" ToolTip="Minimieren"/>
                    <Button Name="MaximizeButton" Content="□" Width="37" Padding="0,5" Margin="0,0,4,0" ToolTip="Maximieren / Wiederherstellen"/>
                    <Button Name="CloseButton" Width="37" Padding="0,4" Background="#53283C" ToolTip="Schließen" AutomationProperties.Name="Schließen">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="#FFF1F5" StrokeThickness="1.8" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
                <TextBlock Text="VoltDeck" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
            </DockPanel>
        </Border>
    <Grid ClipToBounds="True">
        <Viewbox Stretch="Fill" IsHitTestVisible="False" Opacity="{DynamicResource BackdropOpacity}">
            <Canvas Width="1000" Height="660">
                <Path Data="M -140,460 C 150,260 410,72 840,-75 M 30,720 C 410,400 640,240 1160,-40 M 275,720 C 640,450 848,347 1120,250"
                      Stroke="#667592B4" StrokeThickness="3"/>
                <Path Data="M 240,720 C 436,465 615,200 1120,6 C 799,217 596,510 440,720 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#00415370"/>
                            <GradientStop Offset="0.52" Color="#68506482"/>
                            <GradientStop Offset="1" Color="#00415370"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path Data="M 575,760 C 769,461 910,370 1120,344 M -110,270 C 52,139 154,113 360,-20"
                      Stroke="#528C9EB8" StrokeThickness="2"/>
            </Canvas>
        </Viewbox>
        <Grid Margin="24,17,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Name="DashboardClock" FontSize="30" FontWeight="SemiBold"/>
                            <TextBlock Name="DashboardDate" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Name="HeroCard" Style="{StaticResource DashboardCard}" Background="{DynamicResource ThemeHero}" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="Windows Update" FontWeight="SemiBold"/>
                            <Viewbox Width="92" Height="92" HorizontalAlignment="Center" Margin="0,9,0,8" IsHitTestVisible="False">
                                <!-- Keep the scan geometry in its original coordinates for rotation. -->
                                <Grid Width="172" Height="172" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse Width="170" Height="170" Stroke="{DynamicResource ThemeBorder}" StrokeThickness="1"/>
                    <Ellipse Width="151" Height="151" Stroke="{DynamicResource ThemeBorder}" StrokeThickness="1" StrokeDashArray="2,5"/>
                    <Ellipse Width="126" Height="126" Fill="{DynamicResource ThemeControl}" Stroke="{DynamicResource ThemeBorder}" StrokeThickness="2"/>
                    <Ellipse Name="ScanGlow" Width="119" Height="119" Fill="{DynamicResource ThemeAccent}" Opacity="0.08"/>
                    <Path Name="ScanOrbit" Data="M 86,9 A 77,77 0 0 1 159,61" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"
                          Width="172" Height="172" Stretch="None" Opacity="0.76">
                        <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                    </Path>
                    <Path Data="M 27,0 L 2,29 H 21 L 15,50 L 46,19 H 27 L 35,0 Z" Fill="{DynamicResource ThemeAccent}"
                          Width="46" Height="50" Stretch="Uniform"/>
                </Grid>
                            </Viewbox>
                            <TextBlock Name="HeroTitle" Text="Treiber prüfen" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Name="Status" Text="Suche nach Updates, die zu deiner Hardware passen." Foreground="{DynamicResource ThemeMuted}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,5,0,10"/>
                            <Button Name="ScanButton" Content="Nach Updates suchen" Foreground="#FFFFFF" BorderBrush="#2864DA"
                                    Background="#2459C6" Padding="8,7"/>
                            <Button Name="OnlineButton" Content="Online-Zugriff: Aus" Margin="0,6,0,0" Padding="8,6" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Update-Schutz" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Name="RestoreWidget" Foreground="{DynamicResource ThemeMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Name="TestWidget" Foreground="{DynamicResource ThemeMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Name="PlanWidget" Foreground="{DynamicResource ThemeMuted}" FontSize="12" TextWrapping="Wrap"/>
                            <Button Name="AdminButton" Margin="0,10,0,0" Padding="7,6" FontSize="12" Content="Als Administrator öffnen"/>
<Border Name="AdminBadge" Padding="0,8,0,0" Visibility="Collapsed">
    <TextBlock Foreground="{DynamicResource ThemeHeading}" FontSize="12" Text="Administrator aktiv"/>
</Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Name="Filters" LastChildFill="True">
                    <Button Name="FilterButton" DockPanel.Dock="Right" Content="Filter" Margin="7,0,0,0"/>
                    <Grid>
                        <TextBox Name="SearchBox" Background="{DynamicResource ThemeBase}" Foreground="{DynamicResource ThemeText}"
                                 BorderBrush="{DynamicResource ThemeBorder}" Padding="10,6" VerticalContentAlignment="Center"
                                 ToolTip="Gerät, Hersteller, INF oder Version suchen (Ctrl+F)" AutomationProperties.Name="Suche"/>
                        <TextBlock Text="Gerät, Hersteller, INF oder Version suchen (Ctrl+F)" Margin="11,0,0,0"
                                   Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                                                <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,9,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Name="InventoryButton" Style="{StaticResource DashboardShortcut}" Content="Installierte Treiber"
                            Tag="M 3,4 H 21 V 17 H 3 Z M 8,21 H 16 M 12,17 V 21"
                            ToolTip="Geräte, Treiberversionen und INF-Dateien"/>
                    <Button Name="ProblemsButton" Grid.Column="2" Style="{StaticResource DashboardShortcut}" Content="Geräteprobleme"
                            Tag="M 12,3 L 22,21 H 2 Z M 12,9 V 14 M 12,17 V 18"
                            ToolTip="Deaktivierte Geräte, fehlende Treiber und Fehlercodes"/>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="Werkzeuge" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <UniformGrid Name="Actions" Columns="3">
                        <Button Name="BackupButton" Style="{StaticResource DashboardTile}" Content="Treiber sichern"
                                Tag="M 3,5 H 21 V 19 H 3 Z M 3,10 H 21 M 10,15 H 14"/>
                        <Button Name="HistoryButton" Style="{StaticResource DashboardTile}" Content="Treiberverlauf"
                                Tag="M 4,12 A 8,8 0 1 0 7,6 M 4,4 V 9 H 9 M 12,8 V 13 L 15,15"/>
                        <Button Name="ToolsButton" Style="{StaticResource DashboardTile}" Content="Schutz &amp; Diagnose"
                                Tag="M 12,3 L 20,6 V 12 C 20,16 17,19 12,22 C 7,19 4,16 4,12 V 6 Z M 8,12 L 11,15 L 16,9"/>
                        <Button Name="GamingButton" Style="{StaticResource DashboardTile}" Content="Game Ready"
                                Tag="M 8,6 H 16 Q 20,6 21,11 L 22,16 Q 22,20 18,18 L 15,15 H 9 L 6,18 Q 2,20 2,16 L 3,11 Q 4,6 8,6 M 5,11 H 11 M 8,8 V 14 M 16,10 H 17 M 18,12 H 19"/>
                        <Button Name="BoostButton" Style="{StaticResource DashboardTile}" Content="Spiel-Beschleunigung"
                                Tag="M 14,2 L 5,13 H 11 L 10,22 L 20,10 H 14 Z"/>
                        <Button Name="SettingsButton" Style="{StaticResource DashboardTile}" Content="Einstellungen"
                                Tag="M 3,6 H 21 M 3,12 H 21 M 3,18 H 21 M 8,3 V 9 M 16,9 V 15 M 10,15 V 21"/>
                    </UniformGrid>
                </StackPanel>

                <Border Grid.Row="3" Style="{StaticResource DashboardCard}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Treiberübersicht" FontWeight="SemiBold" Margin="4,0,0,7"/>
                        <Border Grid.Row="1" Background="{DynamicResource ThemeBase}" CornerRadius="10" Padding="5">
                    <Grid>
                        <ListBox Name="Updates" Background="Transparent" BorderThickness="0" Padding="4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Name="CopyDetailsMenu" Header="Details kopieren"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource ThemeSelected}" CornerRadius="9" Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Path Data="{Binding IconPath}" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.6"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Treiber}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Treiber}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource ThemeSelected}" CornerRadius="5" Padding="5,1" Margin="0,2,7,0">
                                                    <TextBlock Text="{Binding Badge}" Foreground="{DynamicResource ThemeText}" FontSize="11"/>
                                                </Border>
                                                <TextBlock Text="{Binding Details}" Foreground="{DynamicResource ThemeMuted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Datum}" TextAlignment="Right" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Datumsart}" Foreground="{DynamicResource ThemeMuted}" FontSize="12" TextAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBox Name="Output" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeText}" Padding="12"
                                 FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" CaretBrush="{DynamicResource ThemeText}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed"/>
                        <StackPanel Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                            <TextBlock Name="EmptyTitle" Text="Bereit für den ersten Scan" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Name="EmptyDescription" Text="Die Ergebnisse erscheinen hier." Foreground="{DynamicResource ThemeMuted}" Margin="0,6,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,11,0,0">
                    <Button Name="DetailsButton" Content="Gerätedetails" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button Name="PinButton" Content="Favorit umschalten" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button Name="CompareButton" Content="Treiber vergleichen" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button Name="InstallButton" Content="Ausgewähltes Update installieren" IsEnabled="False"/>
                </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
    </DockPanel>
    </Border>
</Window>
