<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoltDeck" Width="1080" Height="760" MinWidth="790" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip"
        Background="Transparent" Foreground="#EDF3FF"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EDF3FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Name="Track" Width="44" Height="25" CornerRadius="13" Background="{DynamicResource ThemeBase}"
                                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Margin="0,0,10,0">
                                <Ellipse Name="Thumb" Width="17" Height="17" Fill="#F4F1FA" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource ThemeBase}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#F4F1FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ThemeSwatch">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="11" Height="11" Fill="{Binding Swatch}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Label}"/>
            </StackPanel>
        </DataTemplate>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EBF2FF"/>
            <Setter Property="Background" Value="{DynamicResource ThemeControl}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A8F7F8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#EDF3FF"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="Row" Padding="{TemplateBinding Padding}" Margin="0,3" Background="{DynamicResource ThemeControl}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeBorder}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeSelected}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Name="WindowFrame" CornerRadius="19" Background="{DynamicResource ThemeBase}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
    <DockPanel>
        <Border Name="TitleBar" DockPanel.Dock="Top" Background="{DynamicResource ThemeSurface}" CornerRadius="18,18,0,0" Padding="17,6,8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Name="DiscordButton" Width="39" Padding="0,5" Margin="0,0,7,0" Background="#332453" BorderBrush="#B990FF"
                            ToolTip="Discord" AutomationProperties.Name="Discord">
                        <Path Fill="#D5C0FF" Stretch="Uniform" Width="20" Height="16"
                              Data="M 20.3,4.4 A 19.8,19.8 0 0 0 15.4,2.9 L 14.8,4.2 A 18.5,18.5 0 0 0 9.2,4.2 L 8.6,2.9 A 19.8,19.8 0 0 0 3.7,4.4 C 0.6,9 0,13.4 0.3,17.8 A 20.2,20.2 0 0 0 6.3,20.8 L 7.6,18.6 L 5.5,17.6 L 6,17.2 C 9.8,18.9 14.2,18.9 18,17.2 L 18.5,17.6 L 16.4,18.6 L 17.7,20.8 A 20.2,20.2 0 0 0 23.7,17.8 C 24.2,12.8 22.8,8.5 20.3,4.4 Z M 8.1,15.2 C 7,15.2 6.1,14.2 6.1,12.9 C 6.1,11.6 7,10.6 8.1,10.6 C 9.2,10.6 10.1,11.6 10.1,12.9 C 10.1,14.2 9.2,15.2 8.1,15.2 Z M 15.9,15.2 C 14.8,15.2 13.9,14.2 13.9,12.9 C 13.9,11.6 14.8,10.6 15.9,10.6 C 17,10.6 17.9,11.6 17.9,12.9 C 17.9,14.2 17,15.2 15.9,15.2 Z"/>
                    </Button>
                    <Button Name="MinimizeButton" Content="—" Width="37" Padding="0,5" Margin="0,0,4,0" ToolTip="Minimieren"/>
                    <Button Name="MaximizeButton" Content="□" Width="37" Padding="0,5" Margin="0,0,4,0" ToolTip="Maximieren / Wiederherstellen"/>
                    <Button Name="CloseButton" Width="37" Padding="0,4" Background="#53283C" ToolTip="Schließen" AutomationProperties.Name="Schließen">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="#FFF1F5" StrokeThickness="1.8" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
                <TextBlock Text="VOLTDECK  /  DESKTOP" Foreground="#ACBBD8" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
            </DockPanel>
        </Border>
    <Grid Margin="24,15,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,22" LastChildFill="True">
            <Button Name="SettingsButton" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Content="Einstellungen"/>
            <Button Name="AdminButton" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Als Administrator öffnen"/>
            <Border Name="AdminBadge" DockPanel.Dock="Right" VerticalAlignment="Center" Background="#12332F" CornerRadius="8"
                    Padding="12,7" Visibility="Collapsed">
                <TextBlock Foreground="#92F2D4" Text="Administrator aktiv"/>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource ThemeControl}" Width="43" Height="43" CornerRadius="12" Margin="0,0,12,0">
                    <Path Data="M 13,0 L 1,14 H 10 L 7,24 L 23,9 H 13 L 16,0 Z" Fill="{DynamicResource ThemeAccent}"
                          Width="23" Height="24" Stretch="Uniform"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VoltDeck" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Treiberverwaltung für Windows" Foreground="#A0AEC9" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <Border Name="HeroCard" Grid.Row="1" Background="{DynamicResource ThemeHero}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="20" Padding="25,15" Margin="0,0,0,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="WINDOWS UPDATE" Foreground="{DynamicResource ThemeAccent}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Name="HeroTitle" Text="Treiber prüfen" FontSize="36" FontWeight="SemiBold" Margin="0,5,0,5"/>
                    <TextBlock Name="Status" Text="Suche nach Updates, die zu deiner Hardware passen." Foreground="#C1CDE5"
                               TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left" Margin="0,0,0,15"/>
                    <Button Name="ScanButton" Content="Nach Updates suchen" Foreground="#081B22" BorderBrush="{DynamicResource ThemeAccent}"
                            Background="{DynamicResource ThemeAccent}" FontSize="15" HorizontalAlignment="Left" Padding="19,10"/>
                </StackPanel>
                <Grid Grid.Column="1" Width="172" Height="172" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse Width="170" Height="170" Stroke="{DynamicResource ThemeBorder}" StrokeThickness="1"/>
                    <Ellipse Width="151" Height="151" Stroke="{DynamicResource ThemeBorder}" StrokeThickness="1" StrokeDashArray="2,5"/>
                    <Ellipse Width="126" Height="126" Fill="{DynamicResource ThemeControl}" Stroke="{DynamicResource ThemeBorder}" StrokeThickness="2"/>
                    <Ellipse Name="ScanGlow" Width="119" Height="119" Fill="{DynamicResource ThemeAccent}" Opacity="0.08"/>
                    <Path Name="ScanOrbit" Data="M 86,9 A 77,77 0 0 1 159,61" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"
                          Width="172" Height="172" Stretch="None" Opacity="0.76">
                        <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                    </Path>
                    <Path Data="M 27,0 L 2,29 H 21 L 15,50 L 46,19 H 27 L 35,0 Z" Fill="{DynamicResource ThemeAccent}"
                          Width="46" Height="50" Stretch="Uniform"/>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="17" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Name="Actions" Margin="0,0,0,11">
                    <Button Name="InventoryButton" Content="Installierte Treiber" Margin="0,0,8,0"/>
                    <Button Name="ProblemsButton" Content="Geräteprobleme" Margin="0,0,8,0"/>
                    <Button Name="BackupButton" Content="Treiber sichern"/>
                    <Button Name="GamingButton" Content="Game Ready" Margin="8,0,0,0"/>
                    <Button Name="BoostButton" Content="Spiel-Beschleunigung" Margin="8,0,0,0"/>
                    <Button Name="HistoryButton" Content="Treiberverlauf" Margin="8,0,0,0"/>
                </WrapPanel>
                <Border Grid.Row="1" Background="{DynamicResource ThemeBase}" CornerRadius="10" Padding="5">
                    <Grid>
                        <ListBox Name="Updates" Background="Transparent" BorderThickness="0" Padding="4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource ThemeSelected}" CornerRadius="9" Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Path Data="{Binding IconPath}" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.6"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Treiber}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Treiber}"/>
                                            <TextBlock Text="{Binding Details}" Foreground="#ADBEDB" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Datum}" TextAlignment="Right" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Datumsart}" Foreground="#ADBEDB" FontSize="12" TextAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBox Name="Output" Background="Transparent" BorderThickness="0" Foreground="#DAE5F8" Padding="12"
                                 FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" CaretBrush="#DAE5F8"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed"/>
                        <StackPanel Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                            <TextBlock Name="EmptyTitle" Text="Bereit für den ersten Scan" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                            <TextBlock Name="EmptyDescription" Text="Die Ergebnisse erscheinen hier." Foreground="#A0AEC9" Margin="0,6,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,11,0,0">
                    <Button Name="CompareButton" Content="Treiber vergleichen" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button Name="InstallButton" Content="Ausgewähltes Update installieren" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </DockPanel>
    </Border>
</Window>
